# ============================================================================
# Cấu hình Môi trường Phát triển (Local Development Environment)
# Sao chép file này thành '.env' và chỉnh sửa các giá trị thực tế của bạn.
# File '.env' KHÔNG ĐƯỢC PHÉP commit lên Git (đã cấu hình trong .gitignore).
# ============================================================================

# ----------------------------------------------------------------------------
# 1. THÔNG TIN BẢO MẬT & SECRET KEY (Sử dụng cho cả Python local và K8s deployment)
# ----------------------------------------------------------------------------
# Token TMDB API v4 (Lấy tại: https://www.themoviedb.org/settings/api)
TMDB_BEARER_TOKEN="REPLACE_WITH_YOUR_TMDB_BEARER_TOKEN"

# MongoDB Credentials
MONGO_INITDB_ROOT_USERNAME="root"
MONGO_INITDB_ROOT_PASSWORD="ChangeMe-Mongo-Pass"
# Connection string (Dùng localhost nếu chạy direct python local, dùng DNS của k8s nếu chạy trong k8s)
CONNECTION_STRING="mongodb://root:ChangeMe-Mongo-Pass@localhost:27017/?authSource=admin"

# MinIO Credentials
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="ChangeMe-Minio-Pass"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="ChangeMe-Minio-Pass"

# ----------------------------------------------------------------------------
# 2. CẤU HÌNH LIÊN KẾT CƠ SỞ DỮ LIỆU & DỊCH VỤ (Local Direct Run Defaults)
# ----------------------------------------------------------------------------
# Các cấu hình này dùng cho việc chạy trực tiếp script Python từ máy local.
# Mặc định trỏ đến localhost (127.0.0.1). Khi chạy trong Kubernetes,
# ConfigMap (k8s/01-configmap.yaml) sẽ tự ghi đè các giá trị này sang DNS nội bộ cụm.

# Kafka
KAFKA_BOOTSTRAP="localhost:9092"
KAFKA_BROKER1="localhost:9092"
MOVIE_TOPIC="movie"
ACTOR_TOPIC="actor"

# Elasticsearch
ES_NODES="localhost"

# MinIO
MINIO_ENDPOINT="http://localhost:9000"
MINIO_BUCKET="datalake"
MINIO_ENABLED="true"
MINIO_CSV_FILE="tmdb.csv"

# MongoDB Host
MONGO_ENABLED="true"
MONGO_HOST="localhost:27017"

# ----------------------------------------------------------------------------
# 3. CẤU HÌNH WORKLOAD & THAM SỐ ỨNG DỤNG
# ----------------------------------------------------------------------------
# Spark Configuration
MASTER="local[*]"
SPARK_DRIVER_MEMORY="2g"
SHUFFLE_PARTITIONS="50"

# Crawler Ingestion
BATCH_SIZE="50"
CONTINUOUS_MODE="true"
FETCH_INTERVAL="30"
YEARS_TO_FETCH="2025,2024,2023,2022,2021,2020,2019,2018,2017,2016,2015"

# Speed Layer Streaming
WATERMARK_DELAY="10 minutes"
WINDOW_DURATION="5 minutes"
SLIDE_DURATION="1 minute"
TRIGGER_INTERVAL="30 seconds"
MAX_RECORDS_PER_TRIGGER="1000"
CHECKPOINT_DIR="./checkpoint/speed_layer"

# Batch Layer
CSV_PATH="./data/tmdb.csv"

# Serving Layer (Flask)
SERVING_PORT="5000"
CACHE_TTL_SECONDS="60"
DEBUG_MODE="true"
