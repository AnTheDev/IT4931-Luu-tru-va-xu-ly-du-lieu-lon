# ============================================================================
# Cấu hình Secret Kubernetes (Template)
# File này chứa các placeholder biến môi trường để sinh tự động.
# Không commit giá trị thật lên Git.
# ============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: bigdata-secrets
  namespace: bigdata
type: Opaque
stringData:
  # TMDB API token
  TMDB_BEARER_TOKEN: "${TMDB_BEARER_TOKEN}"

  # MongoDB connection string
  CONNECTION_STRING: "mongodb://root:${MONGO_ROOT_PASSWORD}@mongodb.bigdata.svc.cluster.local:27017/?authSource=admin"

  # MinIO credentials (trùng với minio-secret)
  MINIO_ACCESS_KEY: "minioadmin"
  MINIO_SECRET_KEY: "${MINIO_ROOT_PASSWORD}"
---
# Credentials riêng cho StatefulSet MongoDB
apiVersion: v1
kind: Secret
metadata:
  name: mongodb-secret
  namespace: bigdata
type: Opaque
stringData:
  MONGO_INITDB_ROOT_USERNAME: "root"
  MONGO_INITDB_ROOT_PASSWORD: "${MONGO_ROOT_PASSWORD}"
---
# Credentials riêng cho StatefulSet MinIO
apiVersion: v1
kind: Secret
metadata:
  name: minio-secret
  namespace: bigdata
type: Opaque
stringData:
  MINIO_ROOT_USER: "minioadmin"
  MINIO_ROOT_PASSWORD: "${MINIO_ROOT_PASSWORD}"
